<resources>
    <style name="Theme.MatoLiveBus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/deep_green</item>
        <item name="colorPrimary">@color/deep_green</item>
        <item name="colorOnPrimary">@color/warm_white</item>
        <item name="colorSecondary">@color/deep_green</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_green_container</item>
        <item name="colorSecondaryContainer">@color/green_container</item>
        <item name="colorOnSecondaryContainer">@color/on_green_container</item>
        <item name="colorTertiary">@color/deep_green</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <!-- Drawers, dropdowns, menus and dialogs draw on these; unset, Material tints them purple. -->
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/card</item>
        <item name="android:navigationBarColor">@color/warm_white</item>
        <item name="android:statusBarColor">@color/warm_white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
