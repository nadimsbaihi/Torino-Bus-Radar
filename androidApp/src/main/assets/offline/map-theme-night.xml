<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="5" map-background="#1B1F22" map-background-outside="#15181A">
    <rule e="way" k="landuse|leisure|natural" v="forest|wood|grass|meadow|park|garden|recreation_ground">
        <area fill="#27402F"/>
    </rule>
    <rule e="way" k="natural|waterway" v="water|riverbank">
        <area fill="#1F3C58"/>
    </rule>
    <rule e="way" k="waterway" v="river|canal|stream">
        <line stroke="#1F3C58" stroke-width="1.5"/>
    </rule>
    <rule e="way" k="building" v="*" zoom-min="16">
        <area fill="#20252A" stroke="#2F353A" stroke-width="0.25"/>
    </rule>
    <rule e="way" k="highway" v="motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link">
        <line stroke="#2D3135" stroke-width="2.0"/>
        <line stroke="#7A838E" stroke-width="1.5"/>
        <rule e="way" k="*" v="*" zoom-min="13">
            <pathText k="name" font-size="12" fill="#D0D5D9" stroke="#1B1F22" stroke-width="2" repeat-gap="280"/>
        </rule>
    </rule>
    <rule e="way" k="highway" v="tertiary|tertiary_link|residential|unclassified|living_street|pedestrian">
        <line stroke="#16191B" stroke-width="1.2"/>
        <line stroke="#4A525A" stroke-width="0.8"/>
        <rule e="way" k="*" v="*" zoom-min="16">
            <pathText k="name" font-size="11" fill="#AEB5BA" stroke="#1B1F22" stroke-width="2" repeat-gap="300"/>
        </rule>
    </rule>
    <rule e="way" k="highway" v="service|footway|path|steps" zoom-min="16">
        <line stroke="#30353A" stroke-width="0.6"/>
    </rule>
    <rule e="node" k="place" v="city|town" zoom-max="13">
        <caption k="name" font-size="15" fill="#C3CAD0" stroke="#1B1F22" stroke-width="2"/>
    </rule>
</rendertheme>
