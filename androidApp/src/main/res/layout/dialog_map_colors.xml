<?xml version="1.0" encoding="utf-8"?>
<!-- Choosing the map's colours: a preview of a bus beside the rider, then a row of colours for each. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:id="@+id/colorsPreview"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_colors_preview"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/busPreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:importantForAccessibility="no"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/youPreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="centerInside" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/map_colors_buses"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/busSwatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/map_colors_you"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/youSwatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</LinearLayout>
