<?xml version="1.0" encoding="utf-8"?>
<!-- The question over a spot pressed and held on the map. The bubble is white in both themes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bonuspack_bubble"
    android:orientation="vertical">

    <!-- osmdroid's bubble code looks for these without checking they exist. -->
    <ImageView
        android:id="@id/bubble_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <Button
        android:id="@id/bubble_moreinfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@id/bubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@id/bubble_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@id/bubble_subdescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spotCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:textColor="@color/muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spotGo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map_pin_confirm_action"
            android:textColor="@color/deep_green"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
